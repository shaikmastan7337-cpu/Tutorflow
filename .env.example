# TUTORFLOW ENVIRONMENT CONFIGURATION

# Client-side Supabase credentials (Vite exposes variables prefixed with VITE_)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Alternative alias if using publishable key terminology
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Server-side (For Supabase Edge Functions / Backend services)
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# GEMINI_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RESEND_API_KEY=
